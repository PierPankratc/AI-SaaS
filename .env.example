# === VK ===
# Токен сообщества ВКонтакте (вкладка "Работа с API" -> "Ключи доступа")
VK_BOT_TOKEN=your_vk_group_token_here

# === База данных (PostgreSQL, асинхронный драйвер asyncpg) ===
# Для локального запуска вне Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vk_schedule
# Реквизиты для docker-compose (на сервере задайте надёжный пароль!):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=vk_schedule

# === Кэш (Redis) ===
REDIS_URL=redis://localhost:6379/0

# === ЭИОС КГУ ===
EIOS_BASE_URL=https://eios.kosgos.ru
# Прокси для доступа к ЭИОС, если IP сервера блокируется (ошибка 451).
# Пример: http://user:pass@203.0.113.10:8080
EIOS_PROXY_URL=
# Браузерные заголовки (Chrome UA/Referer/Origin): иногда обходит WAF.
EIOS_BROWSER_HEADERS=false
# Переопределить User-Agent (пусто — значение по умолчанию)
EIOS_USER_AGENT=

# === Кэширование (TTL в секундах) ===
CATALOG_CACHE_TTL=86400
SCHEDULE_CACHE_TTL=1800
SCHEDULE_FALLBACK_TTL=604800

# === Прочее ===
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# === Безопасность ===
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=10
MAX_TEXT_LENGTH=512
ONBOARDING_TTL=900

# === База данных (отладка SQL) ===
DB_ECHO=false

# === Мониторинг и логирование ошибок ===
ENVIRONMENT=production
SENTRY_DSN=
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=300

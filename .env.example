# === VK ===
# Токен сообщества ВКонтакте (вкладка "Работа с API" -> "Ключи доступа")
VK_BOT_TOKEN=your_vk_group_token_here

# === Локальная база данных (SQLite внутри проекта) ===
# Здесь лежат профили, черновики, справочники и расписание семестра.
# Бот не делает сетевых запросов: файл готовит CLI-синхронизация.
SQLITE_DB_PATH=data/bot.db

# === Синхронизация семестра из ЭИОС (только CLI) ===
SCHEDULE_SYNC_CONCURRENCY=1
SCHEDULE_SYNC_MIN_INTERVAL=3600
SCHEDULE_SYNC_REQUEST_DELAY=3.0

# === ЭИОС КГУ (используется только CLI-синхронизацией) ===
EIOS_BASE_URL=https://eios.kosgos.ru
# Прокси для доступа к ЭИОС, если IP сервера блокируется (ошибка 451).
# Пример: http://user:pass@203.0.113.10:8080
EIOS_PROXY_URL=
# Браузерные заголовки (Chrome UA/Referer/Origin): иногда обходит WAF.
EIOS_BROWSER_HEADERS=false
# Переопределить User-Agent (пусто — значение по умолчанию)
EIOS_USER_AGENT=

# === Прочее ===
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
DB_ECHO=false

# === Безопасность ===
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW=10
MAX_TEXT_LENGTH=512
ONBOARDING_TTL=900

# === Мониторинг и логирование ошибок ===
ENVIRONMENT=production
SENTRY_DSN=
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=300

